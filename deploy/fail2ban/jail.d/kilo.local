# Jails for Kilo Tracker. Install as /etc/fail2ban/jail.d/kilo.local, with the three files from
# filter.d/ in /etc/fail2ban/filter.d/, then:  fail2ban-client reload
#
# They set only what is specific to Kilo. The ban action (banaction), ignoreip and the default
# bantime come from your [DEFAULT] section (jail.local); check that your action covers ports 80
# and 443 and that ignoreip holds your own address.
#
# The numbers come from five days of real traffic: of 41 visitors, the two scanners sent 295 and
# 12 requests for unknown pages (.env, .git/config, ...) within a minute, and the other 39 sent
# none; nobody typed more than a few wrong codes.

# Scanners asking for pages that do not exist.
[kilo-notfound]
enabled  = true
filter   = kilo-notfound
logpath  = /var/log/gunicorn/kilo-security.log
# read the file itself, whatever backend [DEFAULT] uses (Debian and Ubuntu can set systemd)
backend  = auto
port     = http,https
maxretry = 10
findtime = 60
bantime  = 1h

# Wrong sign-in codes, and requests the code limits refused (not the global cap, see the filter).
[kilo-auth]
enabled  = true
filter   = kilo-auth
logpath  = /var/log/gunicorn/kilo-security.log
backend  = auto
port     = http,https
maxretry = 10
findtime = 10m
bantime  = 1h

# Scanners asking for PHP, WordPress, phpMyAdmin or CGI pages, which Kilo never has: one request is
# enough. In a month of real traffic the scanners sent up to 375 requests within 12 seconds, so
# kilo-notfound banned them only after they had finished; this jail stops them at the first one.
[kilo-probe]
enabled  = true
filter   = kilo-probe
logpath  = /var/log/gunicorn/kilo-security.log
backend  = auto
port     = http,https
maxretry = 1
findtime = 1h
bantime  = 1d
